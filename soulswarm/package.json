{
  "name": "soulswarm",
  "version": "0.1.0",
  "private": true,
  "description": "SOULSWARM: Raise the Legion. Top-down legion-survivor roguelite for iOS & Android.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "playtest": "node scripts/playtest.mjs",
    "balance": "node scripts/balance.mjs",
    "icons": "node scripts/make-icons.mjs",
    "art": "bash scripts/painted-assets.sh",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "trailer": "node scripts/record-trailer.mjs store/trailer-9x16.mp4",
    "screenshots": "node scripts/store-screenshots.mjs",
    "build:web": "SINGLE=1 vite build && node scripts/build-artifact.mjs",
    "build:artifact": "ARTIFACT=1 vite build && node scripts/build-artifact.mjs --multi"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
