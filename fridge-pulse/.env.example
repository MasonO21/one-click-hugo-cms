# Copy to .env (git-ignored). EXPO_PUBLIC_* values are embedded in the app bundle,
# so never put secrets here. Only public SDK keys and URLs belong in this file.

# Base URL of the Fridge Pulse backend (see ./server). Leave empty for demo mode:
# scans return sample data and meal ideas come from a built-in recipe list.
EXPO_PUBLIC_API_URL=

# RevenueCat *public* SDK keys (App Store / Play Store apps in the RevenueCat dashboard).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Set to "demo" to allow the on-device trial simulation in a non-dev build
# (previews, web export). Never set this for a store release.
# EXPO_PUBLIC_BILLING_MODE=demo

# Shown on the paywall and in Settings. Required by the App Store / Play Store.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
