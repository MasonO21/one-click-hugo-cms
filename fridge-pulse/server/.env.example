# Copy to .env for local development. In production set these as real environment variables.

# Anthropic credentials are read from the environment by the official SDK.
ANTHROPIC_API_KEY=

# RevenueCat *secret* API key (Project settings > API keys > Secret). Used to verify that the caller has an
# active trial or subscription. Never put this in the mobile app.
REVENUECAT_SECRET_KEY=
# The entitlement identifier configured in RevenueCat.
REVENUECAT_ENTITLEMENT_ID=pro
# Granted by the household plans as well as pro: its holder covers everyone in their shared household.
REVENUECAT_HOUSEHOLD_ENTITLEMENT_ID=household

# Local development only: skip subscription checks. The server refuses to start without either
# REVENUECAT_SECRET_KEY or this flag.
# ALLOW_UNAUTHENTICATED=true

PORT=8787

# Model and reasoning depth. Defaults: claude-opus-5-5, scan=medium, meals=low, identify=medium.
# ANTHROPIC_MODEL=claude-opus-5-5
# SCAN_EFFORT=medium
# MEALS_EFFORT=low
# IDENTIFY_EFFORT=medium

# Per-user daily caps that bound spend if an account is abused.
# SCANS_PER_DAY=15
# MEALS_PER_DAY=40
# Web lookups of unrecognised items (each runs up to 4 web searches, so it costs more than a scan).
# IDENTIFIES_PER_DAY=10

# Product pictures for lookups come from Open Food Facts and Wikipedia, which ask clients to identify
# themselves. Put a contact address or URL in it.
# PICTURE_USER_AGENT=FridgePulse/1.0 (support@example.com)
# Tests only: point picture lookups at stand-in services.
# OFF_BASE_URL=https://world.openfoodfacts.org
# WIKI_BASE_URL=https://en.wikipedia.org

# Set when running behind a trusted reverse proxy so per-IP limits use X-Forwarded-For.
# TRUST_PROXY=true
# Better, where the host offers one: a header its proxy sets to the caller's address, which callers
# cannot fake. Fly.io sets fly-client-ip (fly.toml already sets this).
# CLIENT_IP_HEADER=fly-client-ip

# Only needed to call the API from a browser (for example the web preview).
# CORS_ORIGIN=http://localhost:8081

# Shared households (Settings > Household in the app) are stored in this SQLite file. Put it on a
# persistent volume (the Dockerfile declares /app/data). Set to "off" to turn household sharing off.
# HOUSEHOLD_DB=data/households.sqlite
