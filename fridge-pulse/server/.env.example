# Copy to .env for local development. In production set these as real environment variables.

# Anthropic credentials are read from the environment by the official SDK.
ANTHROPIC_API_KEY=

# RevenueCat *secret* API key (Project settings > API keys > Secret). Used to verify that the caller has an
# active trial or subscription. Never put this in the mobile app.
REVENUECAT_SECRET_KEY=
# The entitlement identifier configured in RevenueCat.
REVENUECAT_ENTITLEMENT_ID=pro

# Local development only: skip subscription checks. The server refuses to start without either
# REVENUECAT_SECRET_KEY or this flag.
# ALLOW_UNAUTHENTICATED=true

PORT=8787

# Model and reasoning depth. Defaults: claude-opus-5-5, scan=medium, meals=low.
# ANTHROPIC_MODEL=claude-opus-5-5
# SCAN_EFFORT=medium
# MEALS_EFFORT=low

# Per-user daily caps that bound spend if an account is abused.
# SCANS_PER_DAY=15
# MEALS_PER_DAY=40

# Set when running behind a trusted reverse proxy so per-IP limits use X-Forwarded-For.
# TRUST_PROXY=true

# Only needed to call the API from a browser (for example the web preview).
# CORS_ORIGIN=http://localhost:8081
