<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plays N days of the real simulation core with a scripted "competent player" and prints a
    balance table (cash, output, upgrades, themes). Run with: dotnet run, from tools/BalanceSim (XML comments cannot contain a double hyphen)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Scripts/Core/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
