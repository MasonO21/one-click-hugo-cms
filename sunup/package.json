{
  "name": "sunup",
  "version": "0.1.0",
  "description": "Sunup: a one-tap morning check-in that alerts the people who love you if you go quiet.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "NODE_ENV=development tsx watch server/index.ts",
    "demo": "VITE_SUNUP_MODE=demo vite",
    "build:static": "VITE_SUNUP_MODE=demo vite build --outDir dist-static",
    "build": "VITE_SUNUP_MODE=server vite build",
    "build:demo": "VITE_SUNUP_MODE=demo VITE_SUNUP_SINGLE=1 vite build --outDir dist-demo && node scripts/inline.mjs dist-demo",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build:native": "vite build --outDir dist-native && cap sync",
    "android": "npm run build:native && cap open android",
    "ios": "npm run build:native && cap open ios"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.3",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
