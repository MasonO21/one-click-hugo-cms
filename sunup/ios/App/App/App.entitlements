<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Xcode switches this to "production" for App Store builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Lets missed check-in and SOS alerts break through Focus modes. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Invite links (https://YOUR-DOMAIN/?join=CODE) open the app. Replace the domain with yours. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:sunup.example.com</string>
	</array>
</dict>
</plist>
